# =============================================================================
# Shopio backend environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

APP_NAME=Shopio
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
# Public URL of the SPA; used to build links inside verification/reset emails.
FRONTEND_URL=http://localhost:5173
APP_TIMEZONE=UTC
API_PREFIX=/api/v1

# --- Database -----------------------------------------------------------------
# Least-privilege application account. NEVER use root in the application.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shopio_v2
DB_USERNAME=shopio_app
DB_PASSWORD=change-me
DB_CHARSET=utf8mb4
DB_EMULATE_PREPARES=false

# --- Session / auth -----------------------------------------------------------
# Opaque, server-managed sessions. Token is delivered as an HttpOnly cookie
# (browser) and/or an `Authorization: Bearer <token>` header (API clients).
SESSION_COOKIE_NAME=shopio_session
CSRF_COOKIE_NAME=shopio_csrf
# Header the SPA echoes the CSRF cookie value into for cookie-backed writes.
CSRF_HEADER_NAME=x-csrf-token
SESSION_TTL=7200
SESSION_ABSOLUTE_TTL=1209600
SESSION_SECURE_COOKIE=true
SESSION_SAMESITE=Lax
SESSION_COOKIE_PATH=/
SESSION_COOKIE_DOMAIN=

# Require a verified email address before the account may authenticate.
AUTH_REQUIRE_EMAIL_VERIFICATION=true

# Password hashing algorithm: auto | argon2id | bcrypt
PASSWORD_ALGO=auto
PASSWORD_BCRYPT_COST=12
# Optional server-side pepper (HMAC) applied before hashing. Leave empty to
# disable. If set, it must be provided consistently (rotating it invalidates
# existing hashes).
PASSWORD_PEPPER=

# Auth token lifetimes (seconds)
EMAIL_VERIFY_TTL=86400
PASSWORD_RESET_TTL=3600
PHONE_VERIFY_TTL=600

# Progressive delay / rate limiting
AUTH_MAX_ATTEMPTS=8
AUTH_DECAY_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900

# --- CORS ---------------------------------------------------------------------
# Comma-separated explicit allowlist. Wildcard is refused for credentialed use.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# Behind a reverse proxy, list trusted proxy IPs/CIDRs (comma separated) so
# X-Forwarded-For is only honoured from them. Empty = trust direct peer only.
TRUSTED_PROXIES=

# --- Uploads ------------------------------------------------------------------
UPLOAD_DIR=storage/uploads
UPLOAD_BASE_URL=/media
UPLOAD_MAX_BYTES=5242880
UPLOAD_ALLOWED_MIME=image/jpeg,image/png,image/webp

# --- Mail ---------------------------------------------------------------------
# log | smtp | null
MAIL_DRIVER=log
MAIL_FROM=noreply@shopio.local
MAIL_FROM_NAME=Shopio

# --- Payments -----------------------------------------------------------------
# Payment provider adapter. `sandbox` is a signed, offline provider for local dev.
PAYMENT_DEFAULT_PROVIDER=sandbox
PAYMENT_WEBHOOK_TOLERANCE=300
PAYMENT_SANDBOX_SECRET=dev-sandbox-webhook-secret-change-me

# --- Business rules -----------------------------------------------------------
DEFAULT_CURRENCY=TZS
DEFAULT_COMMISSION_RATE=10.00
DEFAULT_SHIPPING_FLAT=0.00
DEFAULT_TAX_RATE=0.00
CART_TTL_SECONDS=2592000
STOCK_RESERVATION_TTL=900
# How long a stored idempotent response is replayed for.
IDEMPOTENCY_TTL_SECONDS=86400

# Public catalogue visibility: only products from approved, active sellers are
# listed. Set false only if unverified sellers may publish directly.
CATALOG_REQUIRE_APPROVED_SELLER=true
# Publish new reviews immediately instead of queueing them for moderation.
REVIEWS_AUTO_PUBLISH=false

# --- Security headers ---------------------------------------------------------
# HSTS is only emitted over HTTPS.
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000

# --- Logistics / scheduled ----------------------------------------------------
# Shared secret for the CLI cron endpoints (release expired reservations etc.)
CRON_TOKEN=change-me

# --- Observability ------------------------------------------------------------
LOG_DIR=storage/logs
LOG_LEVEL=info

# --- Trusted admin seeding ----------------------------------------------------
# Consumed only by `php database/seeders/seed_admin.php`. There is deliberately
# no code path that creates an administrator, so set these in the deployment
# environment (not in a committed file) and run the seeder once.
# SEED_ADMIN_EMAIL=owner@example.com
# SEED_ADMIN_PASSWORD=use-a-strong-12+-char-symbol-password
# SEED_ADMIN_NAME=Shopio Administrator
# Set to 1 to permit seeding while APP_ENV=production.
# SEED_ADMIN_FORCE=0
