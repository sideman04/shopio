 * The single authoritative inventory workflow.
 *
 * INVARIANTS (enforced here and by the supplied triggers/constraints):
 *   1. `inventory.quantity_on_hand` is ONLY changed by inserting into
 *      `inventory_movements` — the supplied AFTER INSERT trigger applies the
 *      delta. PHP never issues `UPDATE inventory SET quantity_on_hand = ...`.
 *   2. `inventory.quantity_reserved` is a hold counter changed only through the
 *      guarded, conditional UPDATEs below, which are atomic at the row level
 *      (`... WHERE quantity_on_hand - quantity_reserved >= :qty`). That is what
 *      prevents overselling when two shoppers check out concurrently.
 *   3. Available stock is always `quantity_on_hand - quantity_reserved`
 *      (matching `fn_variant_available_stock`).
 *   4. Settling a hold = (a) decrease `quantity_reserved`, then (b) insert a
 *      `sale` movement. Order matters: the sale trigger rejects a sale that
 *      would push on-hand below the still-held quantity.
 *
 * `inventory_movements.release_reservation` is intentionally NOT used: it would
 * adjust `quantity_on_hand`, but under strategy (2)+(3) releasing a hold must
 * not change on-hand stock at all. Reservation lifecycle is persisted in
 * `stock_reservations` instead (see migration 0001).
 */";s:10:"attributes";a:0:{}s:9:"startLine";i:29;s:7:"endLine";i:355;s:11:"startColumn";i:1;s:9:"endColumn";i:1;s:15:"parentClassName";s:30:"Shopio\Repositories\Repository";s:20:"implementsClassNames";a:0:{}s:15:"traitClassNames";a:0:{}s:18:"immediateConstants";a:0:{}s:19:"immediateProperties";a:0:{}s:16:"immediateMethods";a:19:{s:10:"forVariant";a:20:{s:4:"name";s:10:"forVariant";s:10:"parameters";a:1:{s:9:"variantId";a:13:{s:4:"name";s:9:"variantId";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:3:"int";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:0:{}s:9:"startLine";i:34;s:7:"endLine";i:34;s:11:"startColumn";i:32;s:9:"endColumn";i:45;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}}s:16:"returnsReference";b:0;s:10:"returnType";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionUnionType";s:4:"data";a:1:{s:5:"types";a:2:{i:0;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:5:"array";s:12:"isIdentifier";b:1;}}i:1;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:4:"null";s:12:"isIdentifier";b:1;}}}}}s:10:"attributes";a:0:{}s:10:"docComment";s:43:"/**
