 */";s:9:"startLine";i:1081;s:7:"endLine";i:1087;s:11:"startColumn";i:9;s:9:"endColumn";i:9;s:10:"couldThrow";b:0;s:9:"isClosure";b:0;s:11:"isGenerator";b:0;s:10:"isVariadic";b:0;s:9:"modifiers";i:1;s:9:"namespace";N;s:18:"declaringClassName";s:3:"PDO";s:21:"implementingClassName";s:3:"PDO";s:16:"currentClassName";s:3:"PDO";s:9:"aliasName";N;}s:5:"query";a:20:{s:4:"name";s:5:"query";s:10:"parameters";a:3:{s:5:"query";a:13:{s:4:"name";s:5:"query";s:7:"default";N;s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:6:"string";s:12:"isIdentifier";b:1;}}s:10:"isVariadic";b:0;s:5:"byRef";b:0;s:10:"isPromoted";b:0;s:10:"attributes";a:1:{i:0;a:3:{s:4:"name";s:50:"JetBrains\PhpStorm\Internal\LanguageLevelTypeAware";s:10:"isRepeated";b:0;s:9:"arguments";a:2:{i:0;a:2:{s:4:"code";s:19:"['8.0' => 'string']";s:10:"attributes";a:6:{s:9:"startLine";i:1114;s:7:"endLine";i:1114;s:13:"startTokenPos";i:3620;s:12:"startFilePos";i:52618;s:11:"endTokenPos";i:3626;s:10:"endFilePos";i:52636;}}s:7:"default";a:2:{s:4:"code";s:2:"''";s:10:"attributes";a:6:{s:9:"startLine";i:1114;s:7:"endLine";i:1114;s:13:"startTokenPos";i:3632;s:12:"startFilePos";i:52648;s:11:"endTokenPos";i:3632;s:10:"endFilePos";i:52649;}}}}}s:9:"startLine";i:1114;s:7:"endLine";i:1115;s:11:"startColumn";i:13;s:9:"endColumn";i:25;s:14:"parameterIndex";i:0;s:10:"isOptional";b:0;}s:9:"fetchMode";a:13:{s:4:"name";s:9:"fetchMode";s:7:"default";a:2:{s:4:"code";s:5:"\null";s:10:"attributes";a:6:{s:9:"startLine";i:1117;s:7:"endLine";i:1117;s:13:"startTokenPos";i:3668;s:12:"startFilePos";i:52817;s:11:"endTokenPos";i:3668;s:10:"endFilePos";i:52820;}}s:4:"type";a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionUnionType";s:4:"data";a:1:{s:5:"types";a:2:{i:0;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\Reflection\ReflectionNamedType";s:4:"data";a:2:{s:4:"name";s:3:"int";s:12:"isIdentifier";b:1;}}i:1;a:2:{s:5:"class";s:55:"PHPStan\BetterReflection\R