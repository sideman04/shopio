          }
        }
      ]
    },
    {
      "name": "Webhooks & Maintenance",
      "item": [
        {
          "name": "Mock payment.succeeded (signed)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Shopio-Timestamp", "value": "{{mockWebhookTs}}" },
              { "key": "X-Shopio-Signature", "value": "{{mockWebhookSig}}" }
            ],
            "body": { "mode": "raw", "raw": "{{mockWebhookBody}}" },
            "url": { "raw": "{{baseUrl}}/webhooks/payments/mock", "host": ["{{baseUrl}}"], "path": ["webhooks", "payments", "mock"] }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Build and sign a mock payment.succeeded webhook.",
                  "const secret = pm.collectionVariables.get('mockSecret');",
                  "const ts = String(Math.floor(Date.now() / 1000));",
                  "const body = JSON.stringify({",
                  "  id: 'evt_' + Date.now(),",
                  "  type: 'payment.succeeded',",
                  "  data: { provider_reference: pm.collectionVariables.get('mockProviderReference') || 'mock_reference_here' }",
                  "});",
                  "const sig = CryptoJS.HmacSHA256(ts + '.' + body, secret).toString(CryptoJS.enc.Hex);",
                  "pm.variables.set('mockWebhookTs', ts);",
                  "pm.variables.set('mockWebhookBody', body);",
                  "pm.variables.set('mockWebhookSig', sig);"
                ]
              }
            }
          ]
        },
        {
          "name": "Run maintenance",
          "request": {
            "method": "POST",
            "header": [{ "key": "X-Cron-Token", "value": "{{cronToken}}" }],
            "url": { "raw": "{{baseUrl}}/internal/maintenance", "host": ["{{baseUrl}}"], "path": ["internal", "maintenance"] }
          }
        }
      ]
    }
  ]
}
