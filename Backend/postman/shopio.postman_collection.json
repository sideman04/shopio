            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"verification_status\": \"approved\",\n  \"commission_rate\": \"10.00\"\n}" },
            "url": { "raw": "{{baseUrl}}/admin/sellers/{{sellerId}}", "host": ["{{baseUrl}}"], "path": ["admin", "sellers", "{{sellerId}}"] }
          }
        },
        {
