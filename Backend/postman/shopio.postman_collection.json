            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"TENOFF\",\n  \"discount_type\": \"percentage\",\n  \"discount_value\": \"10.00\",\n  \"status\": \"active\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/promotions", "host": ["{{baseUrl}}"], "path": ["admin", "promotions"] }
          }
        },
        {
          "name": "List refunds",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/refunds", "host": ["{{baseUrl}}"], "path": ["admin", "refunds"] }
          }
        },
        {
          "name": "Decide refund",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"succeeded\",\n  \"note\": \"Approved\"\n}" },
            "url": { "raw": "{{baseUrl}}/admin/refunds/{{refundId}}", "host": ["{{baseUrl}}"], "path": ["admin", "refunds", "{{refundId}}"] }
          }
