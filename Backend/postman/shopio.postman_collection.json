            "body": { "mode": "raw", "raw": "{\n  \"status\": \"shipped\",\n  \"note\": \"Handed to courier\"\n}" },
            "url": { "raw": "{{baseUrl}}/admin/orders/{{orderId}}/status", "host": ["{{baseUrl}}"], "path": ["admin", "orders", "{{orderId}}", "status"] }
          }
        },
        {
          "name": "Create promotion",
          "request": {
            "method": "POST",
