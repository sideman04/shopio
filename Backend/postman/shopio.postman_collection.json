            "body": { "mode": "raw", "raw": "{\n  \"status\": \"active\"\n}" },
            "url": { "raw": "{{baseUrl}}/admin/products/1", "host": ["{{baseUrl}}"], "path": ["admin", "products", "1"] }
          }
        },
        {
          "name": "Update order status",
