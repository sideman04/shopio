# Shopio frontend environment configuration
#
# The SPA talks to the PHP REST API in Backend/. The API is versioned under
# /api/v1 and is the single source of truth for all application data.
#
# Vite proxies /api to http://127.0.0.1:8000 in development and preview, which
# keeps requests same-origin and lets an HTTPS tunnel serve both the app and the
# API on a phone. A deployed build can point this at the public API instead.
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=Shopio
